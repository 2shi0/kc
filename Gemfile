# Jekyll & GitHub Pages dependencies
source "https://rubygems.org"

# Jekyll本体とテーマ
gem "jekyll", "~> 4.3.4"
gem "minima", "~> 2.5"

# 推奨プラグイン
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
end

# Windows環境用のサポート
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", "~> 1.2"
  gem "tzinfo-data"
  gem "wdm", "~> 0.1.1"
end
